{
  "name": "bium-home",
  "productName": "BIUM",
  "version": "0.1.0",
  "description": "BIUM Digital Home — desktop cleanup companion",
  "main": "electron/main.js",
  "author": "CHIC Hackathon",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist": "npm run dist:mac",
    "dist:mac": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg zip --x64 --arm64 --publish never",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "install:local": "npm run dist && bash scripts/install-local.sh"
  },
  "build": {
    "appId": "com.chic.bium.home",
    "productName": "BIUM",
    "copyright": "Copyright © CHIC Hackathon",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "artifactName": "BIUM-${version}-${os}-${arch}.${ext}",
    "files": [
      "electron/**/*",
      "index.html",
      "pet.html",
      "css/**/*",
      "js/**/*",
      "assets/**/*",
      "fixtures/**/*",
      "vendor/bin/**/*",
      "vendor/tika/**/*",
      "package.json",
      "!assets/retriever/retriever-kit.png",
      "!assets/retriever/@2x/**/*",
      "!assets/pets/**/*preview*",
      "!**/.venv*/**/*",
      "!**/_*.png"
    ],
    "asarUnpack": [
      "vendor/bin/**/*",
      "vendor/tika/**/*",
      "node_modules/onnxruntime-node/**/*",
      "assets/icons/**/*"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "extendInfo": {
        "CFBundleDisplayName": "BIUM",
        "CFBundleName": "BIUM",
        "NSHighResolutionCapable": true,
        "LSUIElement": true
      }
    },
    "dmg": {
      "title": "BIUM ${version}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BIUM"
    }
  },
  "devDependencies": {
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "imapflow": "^1.7.0"
  }
}
